# Copie este arquivo para .env.local (nunca commitar o .env.local) e preencha
# com os valores do seu projeto Supabase. Veja supabase/README.md para o
# passo a passo de onde encontrar cada um.
#
# Este arquivo é um modelo e vai pro git: deixe os valores SEMPRE vazios aqui.
# As chaves de verdade ficam só no seu .env.local, na sua máquina.

# Só o endereço do projeto, sem nada depois do .co
# Certo:  https://xxxxxxxxxxxx.supabase.co
# Errado: https://xxxxxxxxxxxx.supabase.co/rest/v1/  (o app já acrescenta essa parte
#         sozinho; com o sufixo aqui, o login abre mas nenhuma consulta ao banco funciona)
VITE_SUPABASE_URL=

# A chave "anon public" (começa com eyJ...). Nunca a service_role.
VITE_SUPABASE_ANON_KEY=
